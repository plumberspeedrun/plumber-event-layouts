{
	"$schema": "http://json-schema.org/draft-07/schema",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"horaro": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"baseUrl": {
					"type": "string",
					"default": "https://horaro.net/-/api/v1/schedules/"
				},
				"scheduleId": {
					"type": "string"
				},
				"columns": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"game": {
							"type": "string",
							"default": "ゲーム"
						},
						"category": {
							"type": "string",
							"default": "カテゴリ"
						},
						"system": {
							"type": "string",
							"default": "機種"
						},
						"releaseYear": {
							"type": "string",
							"default": "release_year"
						},
						"runner": {
							"type": "string",
							"default": "走者"
						},
						"runType": {
							"type": "string",
							"default": "種別"
						}
					}
				},
				"runTypes": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"ffa": {
							"type": "array",
							"items": {
								"type": "string"
							},
							"default": ["個人", "ffa"]
						},
						"team": {
							"type": "array",
							"items": {
								"type": "string"
							},
							"default": ["チーム", "team", "リレー"]
						}
					}
				}
			},
			"required": ["scheduleId"]
		},
		"googleSpreadsheet": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"credentialsPath": {
					"type": "string"
				},
				"spreadsheetId": {
					"type": "string"
				},
				"staffSheetName": {
					"type": "string",
					"default": "Staff"
				},
				"scheduleSheetName": {
					"type": "string",
					"default": "Schedule"
				},
				"nsmbSheetName": {
					"type": "string",
					"default": "NSMB"
				}
			},
			"required": ["credentialsPath", "spreadsheetId"]
		},
		"spotify": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"clientId": {
					"type": "string"
				},
				"clientSecret": {
					"type": "string"
				},
				"redirectUri": {
					"type": "string",
					"default": "http://127.0.0.1:9090/spotify/callback"
				},
				"pollIntervalMs": {
					"type": "number",
					"default": 5000
				},
				"tokensPath": {
					"type": "string",
					"default": "./cfg/spotify-tokens.json"
				}
			},
			"required": ["clientId", "clientSecret"]
		}
	}
}
