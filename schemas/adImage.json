{
	"$schema": "http://json-schema.org/draft-07/schema",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"name": {
			"type": ["string", "null"]
		},
		"visible": {
			"type": "boolean"
		}
	},
	"required": ["name", "visible"],
	"default": {
		"name": null,
		"visible": false
	}
}
