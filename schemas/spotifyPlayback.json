{
	"$schema": "http://json-schema.org/draft-07/schema",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"isPlaying": {
			"type": "boolean",
			"default": false
		},
		"track": {
			"type": ["object", "null"],
			"additionalProperties": false,
			"properties": {
				"id": {
					"type": "string"
				},
				"name": {
					"type": "string"
				},
				"uri": {
					"type": "string"
				},
				"artists": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"albumName": {
					"type": "string"
				},
				"albumImageUrl": {
					"type": "string"
				},
				"durationMs": {
					"type": "number"
				}
			},
			"required": ["id", "name"]
		},
		"progressMs": {
			"type": "number",
			"default": 0
		},
		"deviceName": {
			"type": "string"
		},
		"updatedAt": {
			"type": "string"
		}
	},
	"required": ["isPlaying"],
	"default": { "isPlaying": false, "track": null, "progressMs": 0 }
}
